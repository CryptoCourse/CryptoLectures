                  <varlte respident="response1">0.5</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gbfbec484393843df2f32b31820102d30" title="3">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_answers_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>8.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>3624,7839,6155,4188,1257,4887,8143,4882</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g5138fe2ccfbe89dd4ed1b8b8dc472f59</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Выберите верные утверждения:&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Multiple">
            <render_choice>
              <response_label ident="3624">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Абсолютно стойкий шифр всегда семантически стойкий&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="7839">
                <material>
                  <mattext texttype="text/plain">Любой шифр Шеннона является абсолютно стойким</mattext>
                </material>
              </response_label>
              <response_label ident="6155">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Аддитивный одноразовый блокнот - семантически стойкий шифр&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="4188">
                <material>
                  <mattext texttype="text/plain">Аддитивный одноразовый блокнот переменной длины – семантически стойкий шифр</mattext>
                </material>
              </response_label>
              <response_label ident="1257">
                <material>
                  <mattext texttype="text/plain">Если шифр имеет длины ключей больше длин шифртекстов то он абсолютно стойкий</mattext>
                </material>
              </response_label>
              <response_label ident="4887">
                <material>
                  <mattext texttype="text/plain">Если шифр имеет энтропии и длины ключей больше энтропий и длин шифртекстов то он абсолютно стойкий</mattext>
                </material>
              </response_label>
              <response_label ident="8143">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Если для всех пар сообщение – шифртекст (&lt;img class="equation_image" title="(m,c)\in M\times C" src="https://canvas.instructure.com/equation_images/(m%252Cc)%255Cin%2520M%255Ctimes%2520C?scale=1" alt="LaTeX: (m,c)\in M\times C" data-equation-content="(m,c)\in M\times C" data-ignore-a11y-check=""&gt;&lt;span class="hidden-readable"&gt;&lt;math xmlns="http://www.w3.org/1998/Math/MathML"&gt;
  &lt;mo stretchy="false"&gt;(&lt;/mo&gt;
  &lt;mi&gt;m&lt;/mi&gt;
  &lt;mo&gt;,&lt;/mo&gt;
  &lt;mi&gt;c&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;)&lt;/mo&gt;
  &lt;mo&gt;∈&lt;/mo&gt;
  &lt;mi&gt;M&lt;/mi&gt;
  &lt;mo&gt;×&lt;/mo&gt;
  &lt;mi&gt;C&lt;/mi&gt;
&lt;/math&gt;&lt;/span&gt;) имеется одинаковое количество ключей &lt;img class="equation_image" title="k_i\in K" src="https://canvas.instructure.com/equation_images/k_i%255Cin%2520K?scale=1" alt="LaTeX: k_i\in K" data-equation-content="k_i\in K" data-ignore-a11y-check=""&gt;&lt;span class="hidden-readable"&gt;&lt;math xmlns="http://www.w3.org/1998/Math/MathML"&gt;
  &lt;msub&gt;
    &lt;mi&gt;k&lt;/mi&gt;
    &lt;mi&gt;i&lt;/mi&gt;
  &lt;/msub&gt;
  &lt;mo&gt;∈&lt;/mo&gt;
  &lt;mi&gt;K&lt;/mi&gt;
&lt;/math&gt;&lt;/span&gt;, таких что &lt;img class="equation_image" title="E(k,m)=c" src="https://canvas.instructure.com/equation_images/E(k%252Cm)%253Dc?scale=1" alt="LaTeX: E(k,m)=c" data-equation-content="E(k,m)=c" data-ignore-a11y-check=""&gt;&lt;span class="hidden-readable"&gt;&lt;math xmlns="http://www.w3.org/1998/Math/MathML"&gt;
  &lt;mi&gt;E&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;(&lt;/mo&gt;
  &lt;mi&gt;k&lt;/mi&gt;
  &lt;mo&gt;,&lt;/mo&gt;
  &lt;mi&gt;m&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;)&lt;/mo&gt;
  &lt;mo&gt;=&lt;/mo&gt;
  &lt;mi&gt;c&lt;/mi&gt;
&lt;/math&gt;&lt;/span&gt;, то шифр &lt;img class="equation_image" title="(E,D)" src="https://canvas.instructure.com/equation_images/(E%252CD)?scale=1" alt="LaTeX: (E,D)" data-equation-content="(E,D)" data-ignore-a11y-check=""&gt;&lt;span class="hidden-readable"&gt;&lt;math xmlns="http://www.w3.org/1998/Math/MathML"&gt;
  &lt;mo stretchy="false"&gt;(&lt;/mo&gt;
  &lt;mi&gt;E&lt;/mi&gt;
  &lt;mo&gt;,&lt;/mo&gt;
  &lt;mi&gt;D&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;)&lt;/mo&gt;
&lt;/math&gt;&lt;/span&gt; на &lt;img class="equation_image" title="(K,M,C)" src="https://canvas.instructure.com/equation_images/(K%252CM%252CC)?scale=1" alt="LaTeX: (K,M,C)" data-equation-content="(K,M,C)" data-ignore-a11y-check=""&gt;&lt;span class="hidden-readable"&gt;&lt;math xmlns="http://www.w3.org/1998/Math/MathML"&gt;
  &lt;mo stretchy="false"&gt;(&lt;/mo&gt;
  &lt;mi&gt;K&lt;/mi&gt;
  &lt;mo&gt;,&lt;/mo&gt;
  &lt;mi&gt;M&lt;/mi&gt;
  &lt;mo&gt;,&lt;/mo&gt;
  &lt;mi&gt;C&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;)&lt;/mo&gt;
&lt;/math&gt;&lt;/span&gt; - абсолютно стойкий &amp;nbsp;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="4882">
                <material>
                  <mattext texttype="text/plain">Для семантически стойкого шифра энтропия ключа всегда больше или равна энтропии открытого текста.</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <and>
                <varequal respident="response1">3624</varequal>
                <not>
                  <varequal respident="response1">7839</varequal>
                </not>
                <varequal respident="response1">6155</varequal>
                <varequal respident="response1">4188</varequal>
                <not>
                  <varequal respident="response1">1257</varequal>
                </not>
                <not>
                  <varequal respident="response1">4887</varequal>
                </not>
                <varequal respident="response1">8143</varequal>
                <not>
                  <varequal respident="response1">4882</varequal>
                </not>
              </and>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="gc73f470e0c95d81e342a08c901b8f737" title="4">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>file_upload_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>4.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry></fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>gb35f1c4d27177d231f3dbaf5c489739e</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Пусть &lt;img class="equation_image" title="(E,D)" src="https://canvas.instructure.com/equation_images/(E%252CD)?scale=1" alt="LaTeX: (E,D)" data-equation-content="(E,D)" data-ignore-a11y-check=""&gt; – одноразовый блокнот на &lt;img class="equation_image" title="(K,M,C):M=c=\{0,1\}^L, K=\{ k \in \{0,1\}^L:k_{2i}=1,i=0..{l/2-1}" src="https://canvas.instructure.com/equation_images/(K%252CM%252CC)%253AM%253Dc%253D%255C%257B0%252C1%255C%257D%255EL%252C%2520K%253D%255C%257B%2520k%2520%255Cin%2520%255C%257B0%252C1%255C%257D%255EL%253Ak_%257B2i%257D%253D1%252Ci%253D0..%257Bl%252F2-1%257D?scale=1" alt="LaTeX: (K,M,C):M=c=\{0,1\}^L, K=\{ k \in \{0,1\}^L:k_{2i}=1,i=0..{l/2-1}" data-equation-content="(K,M,C):M=c=\{0,1\}^L, K=\{ k \in \{0,1\}^L:k_{2i}=1,i=0..{l/2-1}" data-ignore-a11y-check=""&gt; (множество векторов длины , для которых чётные координаты равны 1).&amp;nbsp; &lt;br&gt;Является ли &lt;img class="equation_image" title="(E,D)" src="https://canvas.instructure.com/equation_images/(E%252CD)?scale=1" alt="LaTeX: (E,D)" data-equation-content="(E,D)" data-ignore-a11y-check=""&gt; семантически стойким шифром? Если нет продемонстрируйте атаку с преимуществом равным 1.&lt;/p&gt;
&lt;p&gt;Загрузите файл с доказательством стойкости или атакой.&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
        </resprocessing>
      </item>
