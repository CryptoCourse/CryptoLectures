      <item ident="g7233b8b3ce62f9fd196b69bf21bd6183" title="6">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_answers_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>9.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>8548,3890,8595,7169,11,5458,4941,3630,9207</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>g830747a641c287edfe75cf84d35c55e7</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Пусть &lt;img class="equation_image" title="(E,D)" src="https://canvas.instructure.com/equation_images/(E%252CD)?scale=1" alt="LaTeX: (E,D)" data-equation-content="(E,D)" data-ignore-a11y-check=""&gt; – детерминированный семантически стойкий шифр на &lt;img class="equation_image" title="(K,M,C):M=C=\{0,1\}^L" src="https://canvas.instructure.com/equation_images/(K%252CM%252CC)%253AM%253DC%253D%255C%257B0%252C1%255C%257D%255EL?scale=1" alt="LaTeX: (K,M,C):M=C=\{0,1\}^L" data-equation-content="(K,M,C):M=C=\{0,1\}^L" data-ignore-a11y-check=""&gt;. Какие из следующих алгоритмов является семантически стойкими?&lt;/p&gt;
&lt;p&gt;&lt;img class="equation_image" title=" par(a)" src="https://canvas.instructure.com/equation_images/%2520par(a)?scale=1" alt="LaTeX:  par(a)" data-equation-content=" par(a)" data-ignore-a11y-check=""&gt;- чётность вектора &lt;img class="equation_image" title="a" src="https://canvas.instructure.com/equation_images/a?scale=1" alt="LaTeX: a" data-equation-content="a" data-ignore-a11y-check=""&gt;&lt;/p&gt;
&lt;p&gt;&lt;img class="equation_image" title="rev(a)" src="https://canvas.instructure.com/equation_images/rev(a)?scale=1" alt="LaTeX: rev(a)" data-equation-content="rev(a)" data-ignore-a11y-check=""&gt; - смена порядка бит в векторе &lt;img class="equation_image" title="a" src="https://canvas.instructure.com/equation_images/a?scale=1" alt="LaTeX: a" data-equation-content="a" data-ignore-a11y-check=""&gt;&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Multiple">
            <render_choice>
              <response_label ident="8548">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img class="equation_image" title="E'(k,m)=0||E(k,m)" src="https://canvas.instructure.com/equation_images/E'(k%252Cm)%253D0%257C%257CE(k%252Cm)?scale=1" alt="LaTeX: E'(k,m)=0||E(k,m)" data-equation-content="E'(k,m)=0||E(k,m)" data-ignore-a11y-check=""&gt;&lt;span class="hidden-readable"&gt;&lt;math xmlns="http://www.w3.org/1998/Math/MathML"&gt;
  &lt;msup&gt;
    &lt;mi&gt;E&lt;/mi&gt;
    &lt;mo&gt;′&lt;/mo&gt;
  &lt;/msup&gt;
  &lt;mo stretchy="false"&gt;(&lt;/mo&gt;
  &lt;mi&gt;k&lt;/mi&gt;
  &lt;mo&gt;,&lt;/mo&gt;
  &lt;mi&gt;m&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;)&lt;/mo&gt;
  &lt;mo&gt;=&lt;/mo&gt;
  &lt;mn&gt;0&lt;/mn&gt;
  &lt;mrow class="MJX-TeXAtom-ORD"&gt;
    &lt;mo stretchy="false"&gt;|&lt;/mo&gt;
  &lt;/mrow&gt;
  &lt;mrow class="MJX-TeXAtom-ORD"&gt;
    &lt;mo stretchy="false"&gt;|&lt;/mo&gt;
  &lt;/mrow&gt;
  &lt;mi&gt;E&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;(&lt;/mo&gt;
  &lt;mi&gt;k&lt;/mi&gt;
  &lt;mo&gt;,&lt;/mo&gt;
  &lt;mi&gt;m&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;)&lt;/mo&gt;
&lt;/math&gt;&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="3890">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img class="equation_image" title="E'(k,m)=E(k,m)||par(m)" src="https://canvas.instructure.com/equation_images/E'(k%252Cm)%253DE(k%252Cm)%257C%257Cpar(m)?scale=1" alt="LaTeX: E'(k,m)=E(k,m)||par(m)" data-equation-content="E'(k,m)=E(k,m)||par(m)" data-ignore-a11y-check=""&gt;&lt;span class="hidden-readable"&gt;&lt;math xmlns="http://www.w3.org/1998/Math/MathML"&gt;
  &lt;msup&gt;
    &lt;mi&gt;E&lt;/mi&gt;
    &lt;mo&gt;′&lt;/mo&gt;
  &lt;/msup&gt;
  &lt;mo stretchy="false"&gt;(&lt;/mo&gt;
  &lt;mi&gt;k&lt;/mi&gt;
  &lt;mo&gt;,&lt;/mo&gt;
  &lt;mi&gt;m&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;)&lt;/mo&gt;
  &lt;mo&gt;=&lt;/mo&gt;
  &lt;mi&gt;E&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;(&lt;/mo&gt;
  &lt;mi&gt;k&lt;/mi&gt;
  &lt;mo&gt;,&lt;/mo&gt;
  &lt;mi&gt;m&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;)&lt;/mo&gt;
  &lt;mrow class="MJX-TeXAtom-ORD"&gt;
    &lt;mo stretchy="false"&gt;|&lt;/mo&gt;
  &lt;/mrow&gt;
  &lt;mrow class="MJX-TeXAtom-ORD"&gt;
    &lt;mo stretchy="false"&gt;|&lt;/mo&gt;
  &lt;/mrow&gt;
  &lt;mi&gt;p&lt;/mi&gt;
  &lt;mi&gt;a&lt;/mi&gt;
  &lt;mi&gt;r&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;(&lt;/mo&gt;
  &lt;mi&gt;m&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;)&lt;/mo&gt;
&lt;/math&gt;&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="8595">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img class="equation_image" title="E'(k,m)=rev(E(k,m))" src="https://canvas.instructure.com/equation_images/E'(k%252Cm)%253Drev(E(k%252Cm))?scale=1" alt="LaTeX: E'(k,m)=rev(E(k,m))" data-equation-content="E'(k,m)=rev(E(k,m))" data-ignore-a11y-check=""&gt;&lt;span class="hidden-readable"&gt;&lt;math xmlns="http://www.w3.org/1998/Math/MathML"&gt;
  &lt;msup&gt;
    &lt;mi&gt;E&lt;/mi&gt;
    &lt;mo&gt;′&lt;/mo&gt;
  &lt;/msup&gt;
  &lt;mo stretchy="false"&gt;(&lt;/mo&gt;
  &lt;mi&gt;k&lt;/mi&gt;
  &lt;mo&gt;,&lt;/mo&gt;
  &lt;mi&gt;m&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;)&lt;/mo&gt;
  &lt;mo&gt;=&lt;/mo&gt;
  &lt;mi&gt;r&lt;/mi&gt;
  &lt;mi&gt;e&lt;/mi&gt;
  &lt;mi&gt;v&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;(&lt;/mo&gt;
  &lt;mi&gt;E&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;(&lt;/mo&gt;
  &lt;mi&gt;k&lt;/mi&gt;
  &lt;mo&gt;,&lt;/mo&gt;
  &lt;mi&gt;m&lt;/mi&gt;
  &lt;mo stretchy="false"&gt;)&lt;/mo&gt;
  &lt;mo stretchy="false"&gt;)&lt;/mo&gt;
&lt;/math&gt;&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="7169">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;img class="equation_image" title="E'(k,m)=E(k,rev(m))" src="https://canvas.instructure.com/equation_images/E'(k%252Cm)%253DE(k%252Crev(m))?scale=1" alt="LaTeX: E'(k,m)=E(k,rev(m))" data-equation-content="E'(k,m)=E(k,rev(m))" data-ignore-a11y-check=""&gt;&lt;span class="hidden-readable"&gt;&lt;math xmlns="http://www.w3.org/1998/Math/MathML"&gt;
  &lt;msup&gt;
    &lt;mi&gt;E&lt;/mi&gt;
    &lt;mo&gt;′&lt;/mo&gt;
