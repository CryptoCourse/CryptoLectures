          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;div&gt;&lt;p&gt;Вычислить энтропию следующей величины:&lt;/p&gt;
&lt;p&gt;&lt;img class="equation_image" title="a\in_R \{0,1\}^7" src="https://canvas.instructure.com/equation_images/a%255Cin_R%2520%255C%257B0%252C1%255C%257D%255E7?scale=1" alt="LaTeX: a\in_R \{0,1\}^7" data-equation-content="a\in_R \{0,1\}^7" data-ignore-a11y-check=""&gt;, равномерное распределение&lt;/p&gt;&lt;/div&gt;</mattext>
          </material>
          <response_str ident="response1" rcardinality="Single">
            <render_fib fibtype="Decimal">
              <response_label ident="answer1"/>
            </render_fib>
          </response_str>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <or>
                <varequal respident="response1">7.0</varequal>
                <and>
                  <vargte respident="response1">7.0</vargte>
                  <varlte respident="response1">7.0</varlte>
                </and>
              </or>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
